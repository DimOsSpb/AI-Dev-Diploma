SERVICE_NAME="LLMService"
LOG_LEVEL=INFO

# --------------------
# LLM (основной чат-клиент: обычные ответы, транскрипция голоса, модерация)
#
# Секрет можно хранить двумя способами:
# 1) Путь к файлу со значением (должен начинаться с "~", "./" или "/"):
#    LLM_API_KEY="~/.secret/openrouter_api_key"
# 2) Значение напрямую:
LLM_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_URL="https://openrouter.ai/api/v1"
LLM_DEFAULT_MODEL="openai/gpt-oss-120b:free"
# REQUEST_TIMEOUT=30.0
# MAX_RETRIES=3
# HISTORY_LIMIT=10
# Лимит токенов на один ответ агентной модели (защита от runaway generation).
LLM_AGENT_MAX_TOKENS=2048

# Модель и эндпоинт (ключи из ai_catalog.yaml), которые использует ИМЕННО
# LangGraph-агент (app/main.py) для чата и вызова инструментов (RAG/Proxmox).
# Независимы от RAG_LLM_MODEL/RAG_LLM_ENDPOINT ниже (та пара — для прямого
# RAG-ответа без агента). Могут указывать на один и тот же каталожный пункт.
LLM_MODEL="qwen3.5-9b"
LLM_ENDPOINT="llama.cpp"

# Доп. поименованные LLM-эндпоинты из ai_catalog.yaml (нужны, если
# RAG_LLM_ENDPOINT/LLM_ENDPOINT ниже указывают на них).
# Облачный шлюз (пример):
LLM_VSELLM_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_VSELLM_URL="https://api.example.com/v1"
LLM_VSELLM_DEFAULT_MODEL="openai/gpt-5-mini"
# Локальный llama.cpp-сервер (без ключа):
# LLM_LLAMACPP_URL="http://localhost:8080/v1"
# LLM_LLAMACPP_DEFAULT_MODEL="qwen3.5:9b"

LOG_PATH="/tmp/assistant.log"
REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600

# Трейсинг агента (Arize Phoenix), опционально.
# PHOENIX_ENABLED=true
# PHOENIX_COLLECTOR_ENDPOINT="http://phoenix:6006/v1/traces"

#----------------------
# CHAT SERVICE
#
CHAT_REPOSITORY="postgres"
DATABASE_URL="postgresql+asyncpg://chat:chat@localhost:5432/chat"
CHAT_STORAGE_DIR="./var/chats"
# Сколько последних сообщений диалога передавать модели как контекст.
CHAT_CONTEXT_WINDOW="10"

#----------------------
# BOT
#
BOT_TOKEN="xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BACKEND_URL="http://app:8000"
BOT_ADMIN_IDS=""
REQUEST_TIMEOUT=30.0
# /notify-канал backend → bot. Токен — общий секрет.
INTERNAL_TOKEN="xxxxxxxxxxxxxxxxxxxx"
BOT_API_PORT="9000"
# X-Admin-Token для вызовов /chats/admin/* из бота.
ADMIN_TOKEN="xxxxxxxxxxxxxxxxxxxx"
# SOCKS5/HTTP-проxi для Telegram API, если нужен (не обязателен).
# PROXY="socks5://127.0.0.1:9090"

# --------------------
# QDRANT CONFIGURATION
#
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
EMBEDDING_DIM=1024
EMBEDDING_MODEL="qwen3-embedding-0.6b"
EMBEDDING_ENDPOINT="llama.cpp"
EMBEDDING_CACHE_PATH="./var/cache/embeddings"

# --------------------
# RAG
#
# LLM, который формирует ответы RAG/агента (может совпадать с LLM_* выше
# или указывать на другой каталожный эндпоинт, см. ai_catalog.yaml).
RAG_LLM_MODEL="qwen3.5-9b"
RAG_LLM_ENDPOINT="llama.cpp"
RAG_COLLECTION="collection"
RAG_DATA_DIR="data/kb"
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SIMILARITY_TOP_K=3
RAG_SCORE_THRESHOLD=0.5
RAG_RETRIEVE_TOP_K=5

# Реранкер (опционально, но включён по умолчанию).
RAG_RERANKER_ENABLED=true
RAG_RERANKER_ENDPOINT="llama.cpp"
RAG_RERANKER_MODEL="bge-reranker-v2-m3"
RAG_RERANKER_ALGORITHM="bge"
RAG_RERANKER_TOP_N=3
# Нужен только если реранкер/модель тянутся из HuggingFace.
HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# RAG_SPARSE_MODEL=
# RAG_RESTRICT_TO_INTERNAL=false
# RAG_USE_HYBRID=false

#----------------------
# AGENT
#
# postgres — персистентный граф (переживает перезапуск), sqlite — локальный файл.
AGENT_CHECKPOINTER="postgres"
# AGENT_SQLITE_PATH=var/agent_checkpoints.sqlite

# --------------------
# PROXMOX VE (инструменты инфраструктурного агента)
#
# API-токен создаётся в Datacenter -> Permissions -> API Tokens.
PVE_HOST="pve.example.local"
PVE_USER="llm_agent@pve"
PVE_TOKEN_NAME="llm_agent"
PVE_TOKEN_VALUE="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PVE_VERIFY_SSL="false"
# Нода/VMID тестовой VM для демонстрации безопасного действия (снапшот).
PVE_DEFAULT_NODE="pve-01"
PVE_DEFAULT_VMID="100"
# Защита боевого кластера от спама снапшотами: создать снапшот можно
# только для PVE_DEFAULT_NODE/PVE_DEFAULT_VMID (белый список) и не чаще
# PVE_SNAPSHOT_RATE_LIMIT раз за PVE_SNAPSHOT_RATE_WINDOW_SECONDS секунд
# (на весь процесс). Нужно проверяющим: бот живёт на реальном домашнем
# Proxmox автора.
PVE_SNAPSHOT_RATE_LIMIT="3"
PVE_SNAPSHOT_RATE_WINDOW_SECONDS="600"

#----------------------
# УСТАРЕЛО / не используется текущей реализацией
# Оставлено для справки и возможного будущего использования.
#
# Поле qdrant_collection закомментировано в Settings — реально используется RAG_COLLECTION.
# QDRANT_COLLECTION="documents"
#
# Эксперимент по сравнению стратегий чанкинга (Б5.4) — поля объявлены в
# Settings, но нигде не читаются в текущем коде.
# RAG_CHUNKING_STRATEGY="fixed"
# RAG_CHUNK_SIZE_FIXED=512
# RAG_CHUNK_OVERLAP_FIXED=64
# RAG_CHUNK_SIZE_RECURSIVE=500
# RAG_CHUNK_OVERLAP_RECURSIVE=64
# RAG_SEMANTIC_BUFFER_SIZE=1
# RAG_SEMANTIC_BREAKPOINT_THRESHOLD=95.0
#
# Поле admin_chat_id закомментировано в BotSettings — алерты в админ-группу не реализованы.
# ADMIN_CHAT_ID=""
