SERVICE_NAME="LLMService"
# В данной конфигурации - секреты хранятся в закрытом каталоге ~/.secret в виде файлов со значением ключа
# Т.е. в .env в корне репозитория или в папке проекта вы прописываете:
# API_KEY = "~/.secret/api_key" например для OPENROUTER
LLM_API_KEY="~/.secret/openrouter_api_key"
# Или прописываете сразу API_KEY = value.
LLM_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Система поймет как интерпритировать значение
# Важно - для ключа в файле значение пути файла должно начинаться с ["~", "./", "/"]

# --------------
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_DEFAULT_MODEL="openai/gpt-oss-120b:free"

# Дополнительные настройки, имеют значения по умолчанию - см. config.py
#
# REQUEST_TIMEOUT=30.0
# MAX_RETRIES=3
# HISTORY_LIMIT=10
LOG_PATH="/tmp/assistant.log"
REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600
#
#
#----------------------
# CHAT SERVICE
#
CHAT_REPOSITORY="postgres"
DATABASE_URL="postgresql+asyncpg://chat:chat@localhost:5432/chat"
CHAT_STORAGE_DIR="./var/chats"
CHAT_CONTEXT_WINDOW="4096"

#----------------------
# BOOT
#
BOT_TOKEN=""
BACKEND_URL="http://app:8000"
BOT_ADMIN_IDS=""
REQUEST_TIMEOUT=30.0
# /notify-канал backend → bot. Токен — общий секрет.
INTERNAL_TOKEN=""
BOT_API_PORT="9000"
# X-Admin-Token для вызовов /chats/admin/* из бота.
ADMIN_TOKEN=""
# Telegram chat_id админ-группы для алертов. None — drain отключён.
ADMIN_CHAT_ID=""


# --------------------
# QDRANT CONFIGURATION
#
QDRANT__SERVICE__API_KEY="qdrant"
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="documents"
EMBEDDING_DIM=1536  # text-embedding-3-small dimension
